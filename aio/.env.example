# Copy to .env and adjust. Compose reads this file automatically.
#
# Default layout (siblings of this design repo):
#   ownrun-design/   ownrun-server/   ownrun-web/   ownrun-runner/
OWNRUN_SERVER_DIR=../ownrun-server
OWNRUN_WEB_DIR=../ownrun-web
OWNRUN_RUNNER_DIR=../ownrun-runner

OWNRUN_PORT=8080
OWNRUN_ADMIN_USER=admin
OWNRUN_ADMIN_PASSWORD=ownrun
OWNRUN_TIMEZONE=UTC

# First start pulls these into the Ollama volume (empty = skip that pull).
# Space-separated chat models are all pulled; pick one in the SPA UI.
OWNRUN_OLLAMA_MODEL=llama3.2 frob/qwen3.5-instruct:4b
OWNRUN_KB_EMBED_MODEL=nomic-embed-text

# Leave blank to generate on first boot and persist in the data volume.
# OWNRUN_JWT_SECRET=
# OWNRUN_RUNNER_TOKEN=

# Optional: Ollama cloud web search for agent jobs.
# OLLAMA_API_KEY=

# Use Ollama on the host instead of the bundled service:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
